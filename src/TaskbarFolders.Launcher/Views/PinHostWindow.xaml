<Window x:Class="TaskbarFolders.Launcher.Views.PinHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarFolders"
        Width="1" Height="1"
        Left="-32000" Top="-32000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True">
    <!-- Invisible host window required by Windows.UI.Shell.TaskbarManager: the system
         "Allow [App] to pin?" dialog needs a foreground HWND from the calling process to
         attach to. Off-screen + transparent + no taskbar entry means the user never sees
         this window; the system dialog itself is centred on the active monitor by Windows. -->
</Window>
