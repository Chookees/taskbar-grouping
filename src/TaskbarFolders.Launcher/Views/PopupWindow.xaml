<Window x:Class="TaskbarFolders.Launcher.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskbarFolders.Launcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding GroupName}"
        MinWidth="220"
        MaxWidth="600"
        MinHeight="120"
        MaxHeight="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        d:DataContext="{d:DesignInstance Type=vm:PopupViewModel}">
    <Window.Resources>
        <!-- v0.4.1: scale 0.5→1.0 with QuinticEase over 200 ms makes the popup grow up out of
             the clicked tile. ScaleTransform origin set in code-behind (Width/2, Height) =
             bottom-centre of the popup, directly above the clicked tile per
             TaskbarPositionHelper. The Opacity animation targets the inner ChromeRoot Border
             rather than the Window because Win11 24H2 has a render-skip path for
             `AllowsTransparency=True + Window.Opacity` that misses the first frame
             entirely — animating a child element avoids it. XAML defaults below set
             ScaleX/Y=0.5 + ChromeRoot.Opacity=0 so the first paint already shows the From
             state; code-behind fires Storyboard.Begin on the first CompositionTarget.Rendering
             frame so the animation timeline starts on a frame the user will actually see. -->
        <Storyboard x:Key="OpenAnimation">
            <DoubleAnimation Storyboard.TargetName="ChromeRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.5" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.5" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="AppTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.RenderTransform>
        <!-- ScaleX/Y default to 0.5 so the first painted frame already shows the animation's
             From state. CenterX/CenterY are set in code-behind (bottom-centre of the popup)
             once Width/Height are computed in OnSourceInitialized. -->
        <ScaleTransform ScaleX="0.5" ScaleY="0.5" CenterX="0" CenterY="0" />
    </Window.RenderTransform>

    <!-- Layout-only Border: keeps Padding + TextElement.Foreground inheritance but paints nothing.
         AllowsTransparency on the Window plus Brushes.Transparent here means only the icons (and
         the per-tile hover highlight) are visible — the popup chrome disappears entirely.
         x:Name="ChromeRoot" + Opacity="0" default: storyboard fades the *element* in instead
         of Window.Opacity to dodge the Win11 24H2 paint-skip bug noted above. -->
    <Border x:Name="ChromeRoot"
            Background="Transparent"
            Padding="12"
            Opacity="0"
            TextElement.Foreground="{DynamicResource ForegroundDefault}">
        <Grid>
            <!-- Inline error state for missing/empty group — gets its own backdrop so the text
                 stays readable against any wallpaper now that the popup chrome is gone. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="16,12"
                    CornerRadius="6"
                    Background="{DynamicResource ErrorBackdropBrush}"
                    Visibility="{Binding IsUnavailable, Converter={x:Static vm:LauncherBoolToVisibilityConverter.Instance}}">
                <TextBlock Foreground="{DynamicResource ForegroundSubtle}">
                    <Run Text="{Binding GroupName}" FontWeight="SemiBold" /><LineBreak />
                    <Run Text="No apps to launch." />
                </TextBlock>
            </Border>

            <!-- App grid + transient launch-failure banner -->
            <DockPanel Visibility="{Binding IsUnavailable, Converter={x:Static vm:LauncherInverseBoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Padding="10,6"
                        CornerRadius="6"
                        Background="#CCC42B1C"
                        BorderBrush="#88C42B1C"
                        BorderThickness="1"
                        Visibility="{Binding LastError, Converter={x:Static vm:LauncherNullToCollapsedConverter.Instance}}">
                    <TextBlock Text="{Binding LastError}"
                               Foreground="{DynamicResource ForegroundDefault}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PopupAppViewModel}">
                            <Button Style="{StaticResource AppTileButton}"
                                    Width="96" Height="96"
                                    ToolTip="{Binding Name}"
                                    Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Name}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="80" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
