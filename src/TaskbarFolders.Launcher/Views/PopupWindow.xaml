<Window x:Class="TaskbarFolders.Launcher.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TaskbarFolders.Launcher.Behaviors"
        xmlns:vm="clr-namespace:TaskbarFolders.Launcher.ViewModels"
        Title="TaskbarFolders"
        SizeToContent="WidthAndHeight"
        MinWidth="200"
        MaxWidth="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        behaviors:FocusLossBehavior.CloseOnFocusLoss="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PopupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource PopupBackgroundBrush}"
            BorderBrush="{StaticResource PopupBorderBrush}"
            BorderThickness="1"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Group Name Header -->
            <TextBlock Text="{Binding GroupName}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppLabelBrush}"
                       Margin="4,0,4,8" />

            <!-- App Grid -->
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppEntryViewModel}">
                        <Button Style="{StaticResource AppButtonStyle}"
                                Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Path}"
                                Margin="4"
                                Width="80" Height="90">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="48" Height="48"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="11"
                                           Foreground="{StaticResource AppLabelBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="72" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
