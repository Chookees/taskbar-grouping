<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Slight transparency so Mica/Acrylic can show through on Win11 22H2+. -->
    <SolidColorBrush x:Key="PopupBackground" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="PopupBorder" Color="#22000000" />
    <SolidColorBrush x:Key="ForegroundDefault" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ForegroundSubtle" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TileHoverBackground" Color="#1F0078D4" />
</ResourceDictionary>
