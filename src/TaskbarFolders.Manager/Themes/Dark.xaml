<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#252525" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#2D2D2D" />
    <SolidColorBrush x:Key="DropZoneBackground" Color="#2A2A2A" />

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundDefault" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ForegroundSubtle" Color="#A0A0A0" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderEmphasis" Color="#454545" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
</ResourceDictionary>
