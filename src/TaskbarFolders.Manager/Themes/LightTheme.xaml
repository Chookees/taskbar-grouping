<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#FAFAFA" />

    <!-- Foreground -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#B0B0B0" />

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B71C1C" />

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#D6EBFF" />
    <SolidColorBrush x:Key="HoverItemBrush" Color="#E8E8E8" />

</ResourceDictionary>
