<Application x:Class="TaskbarFolders.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Control styles only. The colour dictionary is merged at runtime by
                     ThemeService, which inserts Light.xaml or Dark.xaml at index 0 and swaps
                     it live. Everything here resolves its brushes via DynamicResource, so the
                     order of these two is irrelevant and a theme swap repaints in place. -->
                <ResourceDictionary Source="/TaskbarFolders.Manager;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
