<Window x:Class="TaskbarFolders.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskbarFolders.Manager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: group list + add controls -->
        <DockPanel Grid.Column="0" Background="#F5F5F5">
            <Border DockPanel.Dock="Top" Padding="12,12,12,8" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="180"
                             VerticalContentAlignment="Center"
                             Padding="6,4"
                             Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="New group name"
                             KeyDown="NewGroupName_KeyDown" />
                    <Button Content="+ Add"
                            Margin="6,0,0,0"
                            Padding="10,4"
                            Command="{Binding AddGroupCommand}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupListItemViewModel}">
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontSize="14" />
                            <TextBlock Text="{Binding AppCount, StringFormat='{}{0} app(s)'}"
                                       FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete group"
                                  Command="{Binding PlacementTarget.DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- Detail pane: replaced by the group editor in M3.3 -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding SelectedGroup}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupListItemViewModel}">
                        <StackPanel Margin="24" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Light" />
                            <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.5" Margin="0,4,0,16" />
                            <Border Background="#F0F0F0" Padding="16" CornerRadius="8">
                                <TextBlock TextWrapping="Wrap" Opacity="0.7">
                                    Drag &amp; drop and the live composite preview land in M3.3 — for now this pane
                                    proves the binding chain (sidebar selection → detail pane content) is wired.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Fallback when no group is selected -->
            <TextBlock Text="Select a group to view details, or click + Add to create one."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.5"
                       Visibility="{Binding SelectedGroup, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />
        </Grid>
    </Grid>
</Window>
