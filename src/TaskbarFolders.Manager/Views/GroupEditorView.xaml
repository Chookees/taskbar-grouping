<UserControl x:Class="TaskbarFolders.Manager.Views.GroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:TaskbarFolders.Manager.Behaviors"
             xmlns:converters="clr-namespace:TaskbarFolders.Manager.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="600">

            <!-- Header -->
            <TextBlock Text="Gruppe bearbeiten"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,20" />

            <!-- Group Name -->
            <TextBlock Text="Gruppenname" FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource FieldTextBoxStyle}"
                     Margin="0,0,0,16" />

            <!-- Columns -->
            <TextBlock Text="Spalten im Popup" FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding ColumnOptions}"
                      SelectedItem="{Binding Columns}"
                      Style="{DynamicResource FieldComboBoxStyle}"
                      Margin="0,0,0,20" Width="80" HorizontalAlignment="Left" />

            <!-- Composite Icon Preview -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,20"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding CompositeIcon}"
                           Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Composite-Icon Vorschau"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Drop Zone -->
            <Border Background="{DynamicResource DropZoneBackgroundBrush}"
                    BorderBrush="{DynamicResource DropZoneBorderBrush}"
                    BorderThickness="2" CornerRadius="8"
                    Padding="24" Margin="0,0,0,20"
                    MinHeight="80"
                    behaviors:FileDragDropBehavior.IsEnabled="True"
                    behaviors:FileDragDropBehavior.DropCommand="{Binding DropFilesCommand}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📂"
                               FontSize="28" HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text=".exe oder .lnk Dateien hierher ziehen"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Apps List -->
            <TextBlock Text="Anwendungen" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}"
                                       Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource FieldTextBoxStyle}"
                                             BorderThickness="0" Padding="0" FontSize="13"
                                             Background="Transparent" />
                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="✕"
                                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        FontSize="14" Foreground="{DynamicResource DangerBrush}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="6,2"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Save -->
            <Button Content="Speichern"
                    Command="{Binding SaveCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0" />

            <!-- Shortcut Info -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="12" Margin="0,16,0,0"
                    Visibility="{Binding ShortcutPath, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="Verknüpfung erstellt" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Ziehe die Verknüpfung auf die Taskleiste zum Anheften:"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding ShortcutPath, Mode=OneWay}"
                             IsReadOnly="True" FontSize="11"
                             Foreground="{DynamicResource MutedTextBrush}"
                             Background="Transparent" BorderThickness="0"
                             Padding="0" />
                    <Button Content="Ordner öffnen"
                            Click="OnOpenShortcutFolder"
                            Style="{DynamicResource SidebarButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
