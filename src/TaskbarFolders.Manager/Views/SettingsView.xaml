<UserControl x:Class="TaskbarFolders.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="500">

            <!-- Header -->
            <TextBlock Text="Einstellungen"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,24" />

            <!-- Auto Start -->
            <CheckBox IsChecked="{Binding AutoStart}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,0,0,16">
                <TextBlock Text="Mit Windows starten" FontSize="13" />
            </CheckBox>

            <!-- Animations -->
            <CheckBox IsChecked="{Binding EnableAnimations}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Margin="0,0,0,20">
                <TextBlock Text="Popup-Animationen aktivieren" FontSize="13" />
            </CheckBox>

            <!-- Theme -->
            <TextBlock Text="Design" FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding Theme}"
                      Style="{DynamicResource FieldComboBoxStyle}"
                      Width="200" HorizontalAlignment="Left"
                      Margin="0,0,0,16" />

            <!-- Popup Position -->
            <TextBlock Text="Popup-Position" FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding PopupPositionOptions}"
                      SelectedItem="{Binding PopupPosition}"
                      Style="{DynamicResource FieldComboBoxStyle}"
                      Width="200" HorizontalAlignment="Left"
                      Margin="0,0,0,24" />

            <!-- Save -->
            <Button Content="Speichern"
                    Command="{Binding SaveCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
