# Auto-detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp
*.csx text diff=csharp

# Project files
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# XAML files
*.xaml text eol=crlf

# Config files
*.json text
*.yml text
*.yaml text
*.xml text
*.config text

# Documentation
*.md text diff=markdown
*.txt text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.dll binary
